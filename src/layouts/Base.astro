---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import { locales, localeNames, t, type Lang } from '../i18n';
import { base, href, img, jsonLd, list, md, one } from '../lib';
import logoFile from '../assets/uploads/logo.png';

interface Props { lang: Lang; title?: string; description?: string; image?: string; noindex?: boolean; }
const { lang, title, description, image, noindex } = Astro.props;
const _ = t(lang);
const site = await one('settings', 'site', lang);
const logo = img(site.logo) ?? logoFile;

const rest = Astro.url.pathname.slice(base.length).split('/').slice(2).join('/');
const fullTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.tagline}`;
const og = await getImage({ src: img(image) ?? img(site.shareImage) ?? logo, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const favicon = await getImage({ src: logo, width: 64, height: 64, format: 'png' });
const touch = await getImage({ src: logo, width: 180, height: 180, format: 'png' });
const logoSmall = await getImage({ src: logo, width: 96, height: 96, format: 'webp' });

// Colours chosen in /admin → Settings → Theme (only valid hex codes are used).
const hex = (v: unknown) => (typeof v === 'string' && /^#[0-9a-f]{3,8}$/i.test(v) ? v : '');
const theme = site.theme ?? {};
const themeVars = Object.entries({ paper: theme.background, 'paper-2': theme.background2, ink: theme.text, moss: theme.green, 'moss-deep': theme.darkGreen, clay: theme.accent })
  .filter(([, v]) => hex(v)).map(([k, v]) => `--${k}:${v}`).join(';');

type Item = [path: string, label: string];
const nav: Item[] = [
  ['about', _('nav_about')], ['place', _('nav_place')], ['life', _('nav_life')], ['inhabitants', _('nav_inhabitants')],
  ['activities', _('nav_activities')], ['activities/esc-volunteering', _('nav_volunteer')], ['stories', _('nav_stories')],
  ['calendar', _('nav_calendar')], ['gallery', _('nav_gallery')], ['support', _('nav_support')], ['contact', _('nav_contact')],
];
// Pages created by the admins (Extra pages) with "Show in menu" ticked.
const extras: Item[] = (await list('extra', lang)).filter((p) => p.inMenu && p.title).sort((a, b) => (a.order ?? 99) - (b.order ?? 99)).map((p) => [p.id, p.title]);
const quick: Item[] = [nav[4], nav[5], nav[7], nav[10]];
const current = (p: string) => (rest.replace(/\/$/, '') === p ? 'page' : undefined);
const tel = (p: string) => `tel:${p.replace(/[^\d+]/g, '')}`;

const ld = {
  '@context': 'https://schema.org', '@type': 'NGO', name: site.name, url: new URL(href(lang), Astro.site).href,
  logo: new URL(touch.src, Astro.site).href, email: site.email, telephone: site.phone, description: site.description,
  taxID: site.taxId || undefined, address: site.address,
  sameAs: [site.instagram, site.facebook].filter(Boolean),
};
---
<!doctype html>
<html lang={lang} style={themeVars || undefined}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="referrer" content="strict-origin-when-cross-origin" />
  <title>{fullTitle}</title>
  <meta name="description" content={description || site.description} />
  {noindex ? <meta name="robots" content="noindex" /> : <>
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    {locales.map((l) => <link rel="alternate" hreflang={l} href={new URL(href(l, rest), Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(href('en', rest), Astro.site)} />
  </>}
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description || site.description} />
  <meta property="og:image" content={new URL(og.src, Astro.site)} />
  <meta property="og:locale" content={lang} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content={hex(theme.darkGreen) || '#22402a'} />
  <link rel="icon" href={favicon.src} type="image/png" />
  <link rel="apple-touch-icon" href={touch.src} />
  <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
  <script type="application/ld+json" set:html={jsonLd(ld)} />
</head>
<body>
  <a class="skip" href="#main">{_('skip')}</a>
  {site.announcement && <div class="announce" set:html={md(site.announcement)} />}
  <header class="site-header">
    <div class="wrap">
      <a class="brand" href={href(lang)} aria-label={site.name}><img src={logoSmall.src} alt="" width="42" height="42" /><span>{site.name}</span></a>
      <ul class="quick">
        {quick.map(([p, label]) => <li><a href={href(lang, p)} aria-current={current(p)}>{label}</a></li>)}
        {site.yogaStudiosUrl && <li><a class="ext" href={site.yogaStudiosUrl} target="_blank" rel="noopener">{_('nav_yoga')}</a></li>}
      </ul>
      <details class="lang">
        <summary aria-label={`${lang} · ${_('language')}`}>{lang} <span aria-hidden="true">▾</span></summary>
        <ul>{locales.map((l) => <li><a href={href(l, rest)} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>{localeNames[l]}</a></li>)}</ul>
      </details>
      <button class="menu-btn" popovertarget="menu" aria-label={_('menu')}><span>{_('menu')}</span><i></i></button>
    </div>
  </header>

  <div id="menu" popover>
    <div class="wrap">
      <div class="top">
        <a class="brand" href={href(lang)} aria-label={site.name} style="color: var(--paper)"><img src={logoSmall.src} alt="" width="42" height="42" /><span>{site.name}</span></a>
        <button class="menu-btn" popovertarget="menu" popovertargetaction="hide">{_('close')} ✕</button>
      </div>
      <nav aria-label={_('menu')}>
        <ol>
          <li><a href={href(lang)}>{_('nav_home')}</a></li>
          {[...nav, ...extras].map(([p, label]) => <li><a href={href(lang, p)} aria-current={current(p)}>{label}</a></li>)}
          {site.yogaStudiosUrl && <li><a class="ext" href={site.yogaStudiosUrl} target="_blank" rel="noopener">{_('nav_yoga')}</a></li>}
        </ol>
      </nav>
      <div class="meta">
        {site.email && <a href={`mailto:${site.email}`}>{site.email}</a>}
        {site.phone && <a href={tel(site.phone)}>{site.phone}</a>}
        {site.instagram && <a class="ext" href={site.instagram} target="_blank" rel="noopener">Instagram</a>}
        {site.facebook && <a class="ext" href={site.facebook} target="_blank" rel="noopener">Facebook</a>}
      </div>
    </div>
  </div>

  <main id="main"><slot /></main>

  <footer class="site-footer">
    <div class="wrap">
      <p class="big">{site.tagline}</p>
      <div class="cols">
        <div>
          <p class="label">{_('discover')}</p>
          <ul>{nav.slice(0, 4).map(([p, label]) => <li><a href={href(lang, p)}>{label}</a></li>)}</ul>
        </div>
        <div>
          <p class="label">{_('nav_activities')}</p>
          <ul>{[...nav.slice(4), ...extras].map(([p, label]) => <li><a href={href(lang, p)}>{label}</a></li>)}</ul>
        </div>
        <div>
          <p class="label">{_('nav_contact')}</p>
          <ul>
            {site.email && <li><a href={`mailto:${site.email}`}>{site.email}</a></li>}
            {site.phone && <li><a href={tel(site.phone)}>{site.phone}</a></li>}
            {site.address && <li>{site.address}</li>}
          </ul>
        </div>
        <div>
          <p class="label">{_('followUs')}</p>
          <ul>
            {site.instagram && <li><a class="ext" href={site.instagram} target="_blank" rel="noopener">Instagram</a></li>}
            {site.facebook && <li><a class="ext" href={site.facebook} target="_blank" rel="noopener">Facebook</a></li>}
            {site.yogaStudiosUrl && <li><a class="ext" href={site.yogaStudiosUrl} target="_blank" rel="noopener">{_('yogaCta')}</a></li>}
            {site.yogaRetreatsUrl && <li><a class="ext" href={site.yogaRetreatsUrl} target="_blank" rel="noopener">Evergreen Yoga Retreats</a></li>}
            {site.yogaTrainingsUrl && <li><a class="ext" href={site.yogaTrainingsUrl} target="_blank" rel="noopener">{_('trainingsCta')}</a></li>}
          </ul>
        </div>
      </div>
      <div class="bottom">
        <span>© {new Date().getFullYear()} {site.name} · {_('footerNote')}</span>
        <span><a href={href(lang, 'privacy')}>{_('privacy')}</a> · <a href={`${base}/admin/`} rel="nofollow">Admin</a></span>
      </div>
      <p class="credit">Website by Amine El Wadi · a bug, an idea, a project? <a href="tel:+33755666402">+33 7 55 66 64 02</a> · <a href="mailto:amineelwadi@gmail.com">amineelwadi@gmail.com</a></p>
    </div>
  </footer>
</body>
</html>
